# Python
venv*/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment, and any copy or backup of these (forgerag.toml holds the API
# tokens); the .example template stays tracked
.env
.env.local
.env.*
config/forgerag.toml
config/forgerag.toml.*
!config/forgerag.toml.example

# Data — all runtime state (page images, uploads, job DB, backups)
data/
config/backup_settings.json
data/highlighted_images/
data/uploads/
data/*.sqlite
data/*.sqlite-shm
data/*.sqlite-wal
data/canonicalization/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
logs/
